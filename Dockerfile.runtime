FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS build

WORKDIR /app

COPY package.json package-lock.json /app/
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force

COPY server /app/server
COPY packages /app/packages
COPY scripts /app/scripts
COPY infrastructure/postgres /app/infrastructure/postgres

RUN mkdir -p /app/certs \
    && node -e "const fs=require('node:fs');fetch('https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem').then((response)=>{if(!response.ok)throw new Error('RDS trust bundle download failed');return response.text()}).then((body)=>{if(!body.includes('BEGIN CERTIFICATE'))throw new Error('RDS trust bundle is invalid');fs.writeFileSync('/app/certs/global-bundle.pem',body,{mode:0o444})})"

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:4ac45c93b6c4b2304876569196e5962e55e8ba4ba095e7dde7bf6d7e00efc3b8

ENV NODE_ENV=production \
    PORT=8080 \
    CB_CAP_DATABASE_CA_FILE=/app/certs/global-bundle.pem

WORKDIR /app
COPY --from=build --chown=65532:65532 /app /app

USER 65532:65532
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=4s --start-period=20s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:8080/healthz',{headers:{host:'api.cbcap.sozorockfoundation.org'}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["server/production-index.js"]
